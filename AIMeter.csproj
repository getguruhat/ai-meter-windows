<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to the MSIX startup task API. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AIMeter</AssemblyName>
    <RootNamespace>AIMeter</RootNamespace>
    <Version>1.0.0</Version>
    <Product>AI Meter</Product>
    <Company>GuruHat</Company>
    <ApplicationIcon>assets\AIMeter.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
